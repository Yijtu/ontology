{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology.local/schema/data.schema.json",
  "title": "DataContracts",
  "$comment": "C3 data and computation port shapes. These are type contracts only; adapters own the implementations. ComputePort never reaches the database itself: the service layer hands it bounded, versioned snapshot references.",
  "$defs": {
    "SchemaVersion": {
      "title": "SchemaVersion",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "SourceWatermark": {
      "title": "SourceWatermark",
      "description": "Source-provided progress marker. A backend that cannot expose a stable watermark must say so instead of inventing a cross-store atomic version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["sequence", "timestamp", "opaque"]
        },
        "value": {
          "$ref": "./common.schema.json#/$defs/NonEmptyString"
        }
      }
    },
    "SourceSnapshot": {
      "title": "SourceSnapshot",
      "description": "C3.1: every tool result carries the exact source state it observed. repeatable_read is only consistent inside the originating transaction; result snapshots are archived when an experiment must be reproducible.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "schemaVersion", "readAt", "consistency", "resultDigest"],
      "properties": {
        "sourceRef": {
          "$ref": "./common.schema.json#/$defs/SourceRef"
        },
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "readAt": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        },
        "asOf": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        },
        "watermark": {
          "$ref": "#/$defs/SourceWatermark"
        },
        "consistency": {
          "$ref": "./common.schema.json#/$defs/ConsistencyLevel"
        },
        "resultDigest": {
          "$ref": "./common.schema.json#/$defs/Sha256Digest"
        },
        "archivedResultRef": {
          "$ref": "./common.schema.json#/$defs/ResourceRef"
        }
      }
    },
    "QueryMode": {
      "title": "QueryMode",
      "type": "string",
      "enum": ["direct", "semantic"]
    },
    "ComparisonOperator": {
      "title": "ComparisonOperator",
      "type": "string",
      "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "between", "is_null", "is_not_null"]
    },
    "ScalarValue": {
      "title": "ScalarValue",
      "description": "Parameterised filter value. Identifiers can never come from this position; only confirmed mapping identifiers may name columns.",
      "type": ["string", "number", "boolean", "null"]
    },
    "SemanticFilter": {
      "title": "SemanticFilter",
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldRef", "op", "values"],
      "properties": {
        "fieldRef": {
          "$ref": "./common.schema.json#/$defs/NonEmptyString"
        },
        "op": {
          "$ref": "#/$defs/ComparisonOperator"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScalarValue"
          }
        }
      }
    },
    "TimeWindow": {
      "title": "TimeWindow",
      "description": "Half-open time window [start, end).",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        },
        "end": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        }
      }
    },
    "AggregationKind": {
      "title": "AggregationKind",
      "type": "string",
      "enum": ["none", "sum", "avg", "min", "max", "count", "count_distinct", "median", "p95"]
    },
    "SemanticAggregation": {
      "title": "SemanticAggregation",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fieldRefs", "groupBy"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/AggregationKind"
        },
        "fieldRefs": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/NonEmptyString"
          },
          "minItems": 1
        },
        "groupBy": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/NonEmptyString"
          }
        }
      }
    },
    "OrderBy": {
      "title": "OrderBy",
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldRef", "direction"],
      "properties": {
        "fieldRef": {
          "$ref": "./common.schema.json#/$defs/NonEmptyString"
        },
        "direction": {
          "type": "string",
          "enum": ["asc", "desc"]
        }
      }
    },
    "DirectSqlQueryPlan": {
      "title": "DirectSqlQueryPlan",
      "description": "Direct mode: the LLM proposes a SQL candidate during planning, but StructuredQueryPort only parses, constrains and executes it. A single read-only SELECT/controlled CTE is allowed; AST checks, an object allowlist, parameter binding and a read-only database role enforce the subset. A prefix check for 'SELECT' is not sufficient.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "statementKind", "sql", "parameters", "referencedObjects", "readOnly"],
      "properties": {
        "mode": {
          "const": "direct"
        },
        "statementKind": {
          "type": "string",
          "enum": ["select"]
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScalarValue"
          }
        },
        "referencedObjects": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/SourceObjectRef"
          },
          "minItems": 1
        },
        "readOnly": {
          "const": true
        }
      }
    },
    "SemanticQueryPlan": {
      "title": "SemanticQueryPlan",
      "description": "Semantic mode: expressed with concept/field/link ids, filters, aggregation, time, order and limit. The mapping resolver translates it to a backend dialect; identifiers may only come from a confirmed mapping.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "concepts", "fields", "links", "filters", "orderBy", "limit", "mappingVersion"],
      "properties": {
        "mode": {
          "const": "semantic"
        },
        "concepts": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/NonEmptyString"
          },
          "minItems": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/NonEmptyString"
          },
          "minItems": 1
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/NonEmptyString"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticFilter"
          }
        },
        "aggregation": {
          "$ref": "#/$defs/SemanticAggregation"
        },
        "time": {
          "$ref": "#/$defs/TimeWindow"
        },
        "orderBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrderBy"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "mappingVersion": {
          "$ref": "./common.schema.json#/$defs/VersionRef"
        }
      }
    },
    "QueryPlan": {
      "title": "QueryPlan",
      "oneOf": [
        {
          "$ref": "#/$defs/DirectSqlQueryPlan"
        },
        {
          "$ref": "#/$defs/SemanticQueryPlan"
        }
      ]
    },
    "QueryLimits": {
      "title": "QueryLimits",
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRows", "maxBytes", "maxDurationMs"],
      "properties": {
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxBytes": {
          "$ref": "./common.schema.json#/$defs/ByteSize"
        },
        "maxDurationMs": {
          "$ref": "./common.schema.json#/$defs/DurationMs"
        }
      }
    },
    "SnapshotRequest": {
      "title": "SnapshotRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["consistency"],
      "properties": {
        "consistency": {
          "$ref": "./common.schema.json#/$defs/ConsistencyLevel"
        },
        "asOf": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        }
      }
    },
    "ColumnType": {
      "title": "ColumnType",
      "type": "string",
      "enum": ["string", "integer", "decimal", "boolean", "timestamp", "json", "binary"]
    },
    "QueryColumn": {
      "title": "QueryColumn",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "$ref": "./common.schema.json#/$defs/NonEmptyString"
        },
        "type": {
          "$ref": "#/$defs/ColumnType"
        },
        "unit": {
          "$ref": "./common.schema.json#/$defs/UnitCode"
        },
        "semanticFieldRef": {
          "$ref": "./common.schema.json#/$defs/NonEmptyString"
        }
      }
    },
    "CatalogDescribeRequest": {
      "title": "CatalogDescribeRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeRef"],
      "properties": {
        "scopeRef": {
          "$ref": "./common.schema.json#/$defs/ScopeRef"
        },
        "resourceRefs": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/SourceObjectRef"
          }
        }
      }
    },
    "CatalogResource": {
      "title": "CatalogResource",
      "description": "Only structures visible to the current principal are ever returned.",
      "type": "object",
      "additionalProperties": false,
      "required": ["objectRef", "schemaRevision", "columns"],
      "properties": {
        "objectRef": {
          "$ref": "./common.schema.json#/$defs/SourceObjectRef"
        },
        "schemaRevision": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueryColumn"
          }
        },
        "conceptRefs": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/NonEmptyString"
          }
        }
      }
    },
    "CatalogDescribeResponse": {
      "title": "CatalogDescribeResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["resources", "schemaRevision"],
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogResource"
          }
        },
        "schemaRevision": {
          "$ref": "#/$defs/SchemaVersion"
        }
      }
    },
    "CatalogListRequest": {
      "title": "CatalogListRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeRef"],
      "properties": {
        "scopeRef": {
          "$ref": "./common.schema.json#/$defs/ScopeRef"
        },
        "cursor": {
          "$ref": "./common.schema.json#/$defs/OpaqueCursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "CatalogListResponse": {
      "title": "CatalogListResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["resources", "schemaRevision", "nextCursor"],
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogResource"
          }
        },
        "schemaRevision": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "nextCursor": {
          "type": ["string", "null"]
        }
      }
    },
    "StructuredQueryValidateRequest": {
      "title": "StructuredQueryValidateRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "limits"],
      "properties": {
        "plan": {
          "$ref": "#/$defs/QueryPlan"
        },
        "limits": {
          "$ref": "#/$defs/QueryLimits"
        }
      }
    },
    "StructuredQueryValidateResponse": {
      "title": "StructuredQueryValidateResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "warnings"],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "normalizedPlan": {
          "$ref": "#/$defs/QueryPlan"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/NonEmptyString"
          }
        },
        "rejectedReason": {
          "$ref": "./errors.schema.json#/$defs/PlatformError"
        }
      }
    },
    "StructuredQueryExecuteRequest": {
      "title": "StructuredQueryExecuteRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "limits", "snapshotRequest"],
      "properties": {
        "plan": {
          "$ref": "#/$defs/QueryPlan"
        },
        "limits": {
          "$ref": "#/$defs/QueryLimits"
        },
        "snapshotRequest": {
          "$ref": "#/$defs/SnapshotRequest"
        },
        "cursor": {
          "$ref": "./common.schema.json#/$defs/OpaqueCursor"
        }
      }
    },
    "StructuredQueryExecuteResponse": {
      "title": "StructuredQueryExecuteResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "columns", "rows", "coverage"],
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/SourceSnapshot"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueryColumn"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array"
          }
        },
        "nextCursor": {
          "type": ["string", "null"]
        },
        "coverage": {
          "$ref": "./tools.schema.json#/$defs/ToolCoverage"
        }
      }
    },
    "CancelRequest": {
      "title": "CancelRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRef", "reason"],
      "properties": {
        "targetRef": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "reason": {
          "$ref": "./common.schema.json#/$defs/NonEmptyString"
        }
      }
    },
    "CancelResponse": {
      "title": "CancelResponse",
      "description": "Cancellation is best-effort notification. When a backend cannot cancel, the platform marks the late result abandoned instead of claiming the remote task stopped.",
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRef", "state", "acceptedAt"],
      "properties": {
        "targetRef": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "state": {
          "type": "string",
          "enum": ["cancelling", "cancelled", "unsupported", "already_terminal"]
        },
        "acceptedAt": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        }
      }
    },
    "DocumentSearchMode": {
      "title": "DocumentSearchMode",
      "type": "string",
      "enum": ["keyword", "vector", "hybrid"]
    },
    "ScoreKind": {
      "title": "ScoreKind",
      "description": "A BM25 score and a cosine similarity are not comparable; the score kind is part of the result contract.",
      "type": "string",
      "enum": ["bm25", "cosine", "hybrid_rrf", "none"]
    },
    "IndexVersion": {
      "title": "IndexVersion",
      "type": "object",
      "additionalProperties": false,
      "required": ["indexRef", "generation", "builtAt"],
      "properties": {
        "indexRef": {
          "$ref": "./common.schema.json#/$defs/VersionRef"
        },
        "generation": {
          "$ref": "./common.schema.json#/$defs/RevisionString"
        },
        "builtAt": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        }
      }
    },
    "SearchFilters": {
      "title": "SearchFilters",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/SourceRef"
          }
        },
        "recordedAfter": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        },
        "recordedBefore": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        },
        "validAt": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          }
        },
        "mediaTypes": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/NonEmptyString"
          }
        }
      }
    },
    "DocumentSearchRequest": {
      "title": "DocumentSearchRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "allowedCollectionRefs", "mode"],
      "properties": {
        "query": {
          "$ref": "./common.schema.json#/$defs/NonEmptyString"
        },
        "allowedCollectionRefs": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/NonEmptyString"
          },
          "minItems": 1
        },
        "filters": {
          "$ref": "#/$defs/SearchFilters"
        },
        "mode": {
          "$ref": "#/$defs/DocumentSearchMode"
        },
        "cursor": {
          "$ref": "./common.schema.json#/$defs/OpaqueCursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "DocumentSpan": {
      "title": "DocumentSpan",
      "description": "D3.2: locates a document_version plus page or offset, with the quote digest. OCR text that cannot be located precisely is marked approximate_locator and enters review.",
      "type": "object",
      "additionalProperties": false,
      "required": ["documentRef", "locator", "quoteDigest", "spanKind"],
      "properties": {
        "documentRef": {
          "$ref": "./common.schema.json#/$defs/ResourceRef"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["page", "offset", "approximate_locator"]
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "startOffset": {
              "type": "integer",
              "minimum": 0
            },
            "endOffset": {
              "type": "integer",
              "minimum": 0
            },
            "normalizationMapRef": {
              "$ref": "./common.schema.json#/$defs/NonEmptyString"
            }
          }
        },
        "quoteDigest": {
          "$ref": "./common.schema.json#/$defs/Sha256Digest"
        },
        "spanKind": {
          "type": "string",
          "enum": ["verbatim", "normalized", "approximate"]
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "DocumentSearchResponse": {
      "title": "DocumentSearchResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["spans", "scoreKind", "indexVersion", "completeness", "snapshot"],
      "properties": {
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentSpan"
          }
        },
        "scoreKind": {
          "$ref": "#/$defs/ScoreKind"
        },
        "indexVersion": {
          "$ref": "#/$defs/IndexVersion"
        },
        "completeness": {
          "$ref": "./common.schema.json#/$defs/CompletenessStatus"
        },
        "snapshot": {
          "$ref": "#/$defs/SourceSnapshot"
        },
        "nextCursor": {
          "type": ["string", "null"]
        }
      }
    },
    "ReadSpanRequest": {
      "title": "ReadSpanRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["documentRef", "locator"],
      "properties": {
        "documentRef": {
          "$ref": "./common.schema.json#/$defs/ResourceRef"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["page", "offset", "approximate_locator"]
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "startOffset": {
              "type": "integer",
              "minimum": 0
            },
            "endOffset": {
              "type": "integer",
              "minimum": 0
            },
            "normalizationMapRef": {
              "$ref": "./common.schema.json#/$defs/NonEmptyString"
            }
          }
        },
        "maxBytes": {
          "$ref": "./common.schema.json#/$defs/ByteSize"
        }
      }
    },
    "ReadSpanResponse": {
      "title": "ReadSpanResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["documentRef", "text", "textDigest", "snapshot"],
      "properties": {
        "documentRef": {
          "$ref": "./common.schema.json#/$defs/ResourceRef"
        },
        "text": {
          "type": "string"
        },
        "textDigest": {
          "$ref": "./common.schema.json#/$defs/Sha256Digest"
        },
        "snapshot": {
          "$ref": "#/$defs/SourceSnapshot"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "TelemetryQuality": {
      "title": "TelemetryQuality",
      "type": "string",
      "enum": ["good", "estimated", "suspect", "missing", "unknown"]
    },
    "TelemetryAggregation": {
      "title": "TelemetryAggregation",
      "type": "string",
      "enum": ["raw", "mean", "sum", "min", "max", "last", "first", "integral"]
    },
    "TelemetryReadSeriesRequest": {
      "title": "TelemetryReadSeriesRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["entityRef", "metric", "window", "aggregation"],
      "properties": {
        "entityRef": {
          "$ref": "./common.schema.json#/$defs/ResourceRef"
        },
        "metric": {
          "$ref": "./common.schema.json#/$defs/NonEmptyString"
        },
        "window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "aggregation": {
          "$ref": "#/$defs/TelemetryAggregation"
        },
        "expectedUnit": {
          "$ref": "./common.schema.json#/$defs/UnitCode"
        },
        "qualityFloor": {
          "$ref": "#/$defs/TelemetryQuality"
        },
        "maxPoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "TelemetrySeriesPoint": {
      "title": "TelemetrySeriesPoint",
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "quality"],
      "properties": {
        "timestamp": {
          "$ref": "./common.schema.json#/$defs/Rfc3339UtcTimestamp"
        },
        "value": {
          "$ref": "./common.schema.json#/$defs/DecimalQuantity"
        },
        "quality": {
          "$ref": "#/$defs/TelemetryQuality"
        }
      }
    },
    "TelemetryReadSeriesResponse": {
      "title": "TelemetryReadSeriesResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["entityRef", "metric", "unit", "points", "quality", "snapshot", "completeness"],
      "properties": {
        "entityRef": {
          "$ref": "./common.schema.json#/$defs/ResourceRef"
        },
        "metric": {
