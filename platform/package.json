{
  "name": "@ontology/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "build:web": "pnpm --filter @ontology/app-web run build",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "boundaries": "vitest run tests/architecture",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@ontology/adapter-blob-local": "workspace:*",
    "@ontology/adapter-control-postgres": "workspace:*",
    "@ontology/adapter-data-duckdb": "workspace:*",
    "@ontology/adapter-data-postgres": "workspace:*",
    "@ontology/adapter-extraction-document": "workspace:*",
    "@ontology/adapter-model-company": "workspace:*",
    "@ontology/adapter-model-jev": "workspace:*",
    "@ontology/adapter-runtime-pi": "workspace:*",
    "@ontology/adapter-runtime-template": "workspace:*",
    "@ontology/adapter-search-bm25": "workspace:*",
    "@ontology/adapter-search-web": "workspace:*",
    "@ontology/adapter-transport-local": "workspace:*",
    "@ontology/adapter-transport-mcp": "workspace:*",
    "@ontology/app-api": "workspace:*",
    "@ontology/app-web": "workspace:*",
    "@ontology/application": "workspace:*",
    "@ontology/contracts": "workspace:*",
    "@ontology/core": "workspace:*",
    "@ontology/provenance": "workspace:*",
    "@ontology/semantic-engine": "workspace:*",
    "@ontology/tool-services": "workspace:*",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
